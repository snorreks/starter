# 2. Build output
# =============================================================================
build/
dist/
.output/
.svelte-kit/
.astro/
*.tgz
*.zip
*.tar.gz

# =============================================================================
# 3. Local runtime state
# =============================================================================
# Log *output*, anchored to the repository root and to known output directories.
# Unanchored, `logs/` also matches `scripts/src/lib/logs/` — which is source, and
# would silently never be committed.
#
# See `scripts/src/lib/guards/boundary.ts`: a guard fails if this file ignores
# anything under a `src/` directory.
/logs/
*.log
pids/
*.pid
*.pid.*
/runtime/
/tmp/
*.tmp

# Wrangler's local D1/R2 state. Regenerated by `bun run db:migrate`.
.wrangler/
state/
wrangler.generated.jsonc
.dev.vars
.dev.vars.*

# Provisioned resource ids: account, Worker names, D1/R2 ids.
#
# Written by `bun run deploy:configure -- --provision` and read by `deploy:check`,
# `db:migrate` and the log adapters. Gitignored because these identify a real
# account: committing them would make a fresh clone target somebody else's
# resources, which is the same reason `registry-valid` fails the build on a literal
# id in `app_registry.ts`. Two layers with one rule — a resource id belongs to a
# person, not to the project.
.starter/
!.dev.vars.example

# Native build output, matched by the shell's fixed layout rather than by the
# path of whichever application currently owns it.
#
# A path-anchored entry here was the reason `apps/frontend/client/src-tauri/gen/`
# went untracked: the rule named `apps/frontend/native/…`, the build had been run
# under `apps/frontend/client/`, and a stale entry stops matching silently — the
# failure mode section 9 already records for these paths. Tauri writes `gen/` and
# `target/` wherever the crate is, and `scripts/src/guards/policy.ts` classifies
# both by layout in `GENERATED_TREES`; these rules agree with it.
#
# The `**/` is load-bearing: an interior slash anchors a pattern to the directory
# holding this file, so `src-tauri/gen/` matches only a `src-tauri` at the
# repository root. `**/` is what lets the rule follow the crate wherever it is.
**/src-tauri/target/
**/src-tauri/gen/
**/src-tauri/gen-schemas/
**/src-tauri/vendor/

# =============================================================================
# 4. Environment and secrets
#
#    Rule: examples are committed, real values never are. The `!` exceptions
#    below are the only files allowed to carry variable NAMES.
# =============================================================================
.env
.env.*
!.env.example
!.env.*.example
# SOPS ciphertext belongs to a specific project and specific recipients.
# A template ships tooling and an empty, documented onboarding path instead.
secrets/*.enc.env
secrets/*.enc.yaml
secrets/*.enc.yml
secrets/*.enc.json
!.secrets/README.md
.secrets/
#
# The negations come AFTER the rules they undo, because git takes the last matching
# pattern: a `!` above `secrets/*.enc.env` is ignored, which is the one way to write
# this that looks right and does nothing. These two files are this project's SOPS
# ciphertext, one per environment, so a staging run can never read production
# values. Encrypt BEFORE committing them: `bun run secrets:encrypt` refuses a path
# git is ignoring, and the file has to be ignored while it is still plaintext.
!secrets/staging.enc.env
!secrets/production.enc.env
# Real key material is never in the repository.
*.pem
*.key
*.crt
.age/*.txt
!.age/recipients.txt.example
# The recipient roster is public keys and is meant to be reviewed in a diff; the
# private halves are `.age/*.txt` above, and `.age/.gitignore` ignores this whole
# directory except these two files.
!.age/recipients.txt
!.age/.gitignore
# Never commit a private age identity.
*.agekey
id_ed25519
id_rsa

# =============================================================================
# 5. Local databases
# =============================================================================
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-*

# =============================================================================
# 6. Test and evidence output
#
#    Evidence is a local artifact: it can contain screenshots of unreleased UI
#    and raw model findings. It belongs in review, not in git history.
#
#    Coverage is anchored to the root and to package roots, for the same reason
#    `logs/` is anchored above: an unanchored `coverage/` also matches
#    `scripts/src/coverage/`, which is source. It did — the `source-is-tracked`
#    guard refused two modules that were silently untracked, which is the only
#    reason the collision is fixed here rather than discovered on a fresh clone.
#    Coverage output is written to a package root or the repository root and
#    nowhere else, so those are the only places an anchored rule has to cover.
# =============================================================================
/coverage/
apps/*/*/coverage/
packages/*/*/coverage/
scripts/coverage/
.pi/coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.vitest/
.auth/
/.evidence/
/apps/e2e/.evidence/
/apps/e2e/test-results/
/apps/e2e/playwright-report/
*.png.diff

# =============================================================================
# 7. Agent runtime state
# =============================================================================
.pi/autofix/
.pi/contract-runs/
.pi/subagent-runs/
.pi/workspaces/
.pi/background-tasks/*
!.pi/background-tasks/README.md
# Handoff notes: durable for the machine that wrote them, invisible to git.
#
# A note is evidence about one moment in one worktree. Committed, it lands in
# history, appears in every clone, and goes stale the moment anyone else pushes.
# `handoff { action: "write" }` refuses to write here unless this rule is present.
.pi/handoffs/*
!.pi/handoffs/README.md
.pi/healing_context.json
.pi/pipeline_payload_*.json
.pi/MARKER_*
.pi/infra-issues.jsonl
.pi/swarm/

# =============================================================================
# 8. OS and editor
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/cspell.json
*.swp
*~
.#*
\#*\#

# =============================================================================
# 9. direnv
# =============================================================================
.direnv/
.envrc.local

# Rust build output. `apps/backend/media/.gitignore` and
# `apps/frontend/native/src-tauri/.gitignore` each cover their own crate directory;
# these are the belt-and-braces entries for anyone building from the repository
# root. The path was `apps/frontend/client/src-tauri` until the shell moved to its
# own application, where a stale entry silently stops matching.
apps/backend/media/target/
apps/frontend/native/src-tauri/target/
target/
