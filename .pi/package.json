{
  "name": "@starter/pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome lint extensions lib tests",
    "format": "biome format extensions lib tests",
    "fix": "biome check --write extensions lib tests --error-on-warnings",
    "typecheck": "tsgo --noemit",
    "test": "bun test --path-ignore-patterns='tests/live/**' tests",
    "test:compute-facade": "bun test ./tests/live/compute_facade.test.ts",
    "test:visual-capture-facade": "bun test ./tests/live/visual_capture_facade.test.ts",
    "test:visual-review-facade": "bun test ./tests/live/visual_review_facade.test.ts",
    "loader:smoke": "bun test tests/pi_loader.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/bun": "1.4.2",
    "typebox": "1.3.36"
  }
}
