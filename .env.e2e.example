# Optional structured visual review. Capture-only commands need no provider config.
E2E_VISION_PROVIDER=openrouter
E2E_VISION_MODEL=
E2E_VISION_BASE_URL=https://openrouter.ai/api/v1
# Optional per-project override; otherwise use the global OPENROUTER_API_KEY.
E2E_VISION_API_KEY=
# Optional fallback when a direct CLI/agent environment already has OpenRouter configured.
OPENROUTER_API_KEY=
E2E_VISION_TIMEOUT_MS=60000
E2E_VISION_MAX_CALLS=50
E2E_VISION_MAX_OUTPUT_TOKENS=2500
