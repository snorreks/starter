{
  "name": "@starter/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:headed": "playwright test --config playwright.config.ts --headed",
    "browsers:install": "playwright install --with-deps chromium",
    "capture-evidence": "bun run capture_evidence.ts",
    "typecheck": "tsgo --noemit",
    "lint": "biome lint .",
    "format": "biome format .",
    "fix": "biome check --write . --error-on-warnings"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
