{
  "name": "@starter/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "bun run scripts/run_e2e.ts",
    "test:e2e:playwright": "playwright test --config playwright.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:full": "bun run scripts/run_e2e.ts --full",
    "test:full:playwright": "playwright test --config playwright.full.config.ts",
    "test:audit": "playwright test --config playwright.audit.config.ts",
    "doctor:browser": "bun run src/doctor.ts",
    "full:runtime": "bun run src/full/runtime_host.ts",
    "test:tooling": "bun test src/scenarios scripts src/full src/visual",
    "test:headed": "playwright test --config playwright.config.ts --headed",
    "browsers:install": "playwright install --with-deps chromium",
    "capture-evidence": "bun run test:visual",
    "visual": "bun run test:visual",
    "typecheck": "tsgo --noemit",
    "lint": "biome lint .",
    "format": "biome format .",
    "fix": "biome check --write . --error-on-warnings"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "lighthouse": "13.5.0",
    "miniflare": "5.20261006.0-alpha",
    "valibot": "1.5.0"
  },
  "dependencies": {
    "@starter/fixtures": "workspace:*",
    "@starter/schemas": "workspace:*"
  }
}
