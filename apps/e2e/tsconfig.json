{
  "//": [
    "Playwright transpiles specs; tsgo checks the specs and Bun scripts together.",
    "The `types` entry is Bun for runtime-host and test-helper globals."
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "paths": {
      "@starter/schemas": ["../../packages/shared/schemas/src/index.ts"],
      "@starter/schemas/*": ["../../packages/shared/schemas/src/*"],
      "@starter/logger": ["../../packages/shared/logger/src/index.ts"],
      "@starter/fixtures": ["../../packages/shared/fixtures/src/index.ts"],
      "@starter/utils": ["../../packages/shared/utils/src/index.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report"]
}
