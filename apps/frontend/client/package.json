{
  "name": "@starter/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "imports": {
    "#logger": "./src/lib/runtime/logger.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun run --cwd ../.. scripts/src/cli.ts dev app",
    "dev:worker": "bun run --cwd ../.. scripts/src/cli.ts dev built",
    "build": "vite build && bun ../../../scripts/src/artifacts/bundle_worker.ts",
    "preview": "vite preview",
    "check:bundle": "bun scripts/check_bundle.ts",
    "prepare": "svelte-kit sync",
    "lint": "biome lint src",
    "format": "biome format src",
    "fix": "biome check --write src --error-on-warnings",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "bun run test:unit",
    "test:unit": "bun run test:unit:run",
    "test:unit:run": "bun test --isolate --path-ignore-patterns='src/browser_tests/**' --path-ignore-patterns='tests/worker_integration.test.ts' --preload ./src/lib/test_setup.ts --tsconfig-override=tsconfig.test.json src/lib tests scripts",
    "test:browser": "vitest run --config vitest.config.ts",
    "test:worker": "bun run test:integration",
    "test:integration": "bun run build && bun run scripts/run_integration.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@standard-schema/spec": "1.1.0",
    "@starter/auth": "workspace:*",
    "@starter/database": "workspace:*",
    "@starter/features": "workspace:*",
    "@starter/jobs": "workspace:*",
    "@starter/logger": "workspace:*",
    "@starter/platform": "workspace:*",
    "@starter/schemas": "workspace:*",
    "@starter/ui": "workspace:*",
    "@starter/utils": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@sveltejs/adapter-cloudflare": "8.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.64.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
