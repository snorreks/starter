{
  "name": "@starter/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun run --cwd ../.. scripts/src/cli.ts dev app",
    "dev:worker": "bun run --cwd ../.. scripts/src/cli.ts dev built",
    "build": "vite build",
    "preview": "vite preview",
    "check:bundle": "bun scripts/check_bundle.ts",
    "prepare": "svelte-kit sync",
    "lint": "biome lint src",
    "format": "biome format src",
    "fix": "biome check --write src --error-on-warnings",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "bun run test:unit",
    "test:unit": "bun run test:unit:run",
    "test:unit:run": "bun test --isolate --path-ignore-patterns='src/browser_tests/**' --path-ignore-patterns='tests/worker_integration.test.ts' --preload ./src/lib/test_setup.ts --tsconfig-override=tsconfig.test.json src/lib tests scripts",
    "test:browser": "vitest run --config vitest.config.ts",
    "test:worker": "bun run test:integration",
    "test:integration": "bun run build && bun test tests/worker_integration.test.ts"
  },
  "dependencies": {
    "@starter/auth": "workspace:*",
    "@starter/database": "workspace:*",
    "@starter/logger": "workspace:*",
    "@starter/schemas": "workspace:*",
    "@starter/ui": "workspace:*",
    "@starter/utils": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@sveltejs/adapter-cloudflare": "8.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/browser": "5.0.2",
    "@vitest/browser-playwright": "5.0.2",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  }
}
