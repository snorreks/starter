{
  "name": "@starter/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check:bundle": "bun scripts/check_bundle.ts",
    "prepare": "svelte-kit sync",
    "lint": "biome lint src",
    "format": "biome format src",
    "fix": "biome check --write src --error-on-warnings",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "bun run test:unit && bun run test:browser",
    "test:unit": "bun run test:unit:run",
    "test:unit:run": "bun test --isolate --path-ignore-patterns='src/browser_tests/**' --preload ./src/lib/test_setup.ts --tsconfig-override=tsconfig.test.json src/lib tests",
    "test:browser": "vitest run --config vitest.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "bun scripts/build_tauri.ts",
    "tauri:icon": "tauri icon src-tauri/icons/icon.svg"
  },
  "dependencies": {
    "@starter/frontend-services": "workspace:*",
    "@starter/logger": "workspace:*",
    "@starter/schemas": "workspace:*",
    "@starter/ui": "workspace:*",
    "@starter/utils": "workspace:*",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0-next.4",
    "@sveltejs/kit": "3.0.0-next.30",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/cli": "^2.9.0",
    "@tauri-apps/plugin-log": "2.7.0",
    "@tauri-apps/plugin-opener": "2.5.0",
    "@vitest/browser": "5.0.2",
    "@vitest/browser-playwright": "5.0.2",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
