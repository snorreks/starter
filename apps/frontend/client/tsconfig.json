{
  "//": [
    "Extends SvelteKit's generated base, which supplies `$lib/*`, `$app/*` and",
    "`$app/types`. Do NOT add a `paths` or `types` block here: TypeScript",
    "overrides rather than merges those, so doing so silently removes `$lib`.",
    "Workspace packages (`@starter/*`) resolve through node_modules, because",
    "each package's `exports` points at its TypeScript source."
  ],
  "extends": "$app/tsconfig",
  "compilerOptions": {
    // `$app/types` supplies `App.PageData` and friends, and therefore brings
    // `src/app.d.ts` — where `App.Platform` and `App.Locals` are declared — into
    // the program. It is generated by `svelte-kit sync`, which `prepare` and
    // `typecheck` both run.
    //
    // `bun` is added so the Bun unit lane (src/**/*.test.ts and its preload) is
    // covered by this one program rather than by a second, separately-run check.
    //
    // `@cloudflare/workers-types` supplies `D1Database` and the rest of the
    // platform's global interfaces. It has to be listed here rather than left to
    // be discovered: without it, `App.Platform.DB: D1Database` and every D1 stub
    // in a test resolve to `any` under `skipLibCheck`, and the binding contract
    // this PR introduces would be typed by nothing at all.
    "types": ["$app/types", "bun", "@cloudflare/workers-types/experimental"],
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["src/service-worker"]
}
