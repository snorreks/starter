# apps/frontend/client/.env.example
#
# Copy to `.env` and edit. `.env` is gitignored; this file is not, and must only
# ever contain non-secret defaults.
#
# Every value here is a local-development default. Nothing in this file is
# required to run `bun run dev`, `bun run dev:worker` or the test suites: the
# Worker reads its bindings from `wrangler.jsonc` and the browser reads this
# file, and both have defaults that already work.

# Which environment the browser believes it is in. Drives log labels and
# telemetry.
PUBLIC_MODE=local

# Log level for the browser console.
PUBLIC_LOG_LEVEL=DEBUG

# Build identifier attached to every log event, so a log can be tied to a
# revision. Overridden in CI with the commit SHA.
PUBLIC_APP_VERSION=dev

# Where the browser posts structured events so they become queryable.
#
# A browser cannot write a log file itself, so forwarding is the only route by
# which browser events reach a readable log. The same Worker that serves the page
# accepts them at `/api/telemetry` and re-emits them under `source: browser`, so
# `bun run logs web --mode local` shows both halves of this application.
#
# Set to `off` to disable forwarding entirely.
PUBLIC_TELEMETRY_ENDPOINT=/api/telemetry

# Absolute API origin. Leave empty: the API *is* this origin. The Worker serves
# the HTML, the hashed assets and `/api/*` from one hostname, in development and
# deployed alike, so a relative request is correct and keeps the session cookie
# first-party.
#
# Set it only to point a browser at a *different* deployment's API while
# debugging, e.g. a staging Worker.
PUBLIC_API_BASE_URL=