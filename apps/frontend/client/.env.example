# apps/frontend/client/.env.example
#
# Copy to `.env` and edit. `.env` is gitignored; this file is not, and must only
# ever contain non-secret defaults.
#
# Every value here is a local-development default. Nothing in this file is
# required to run `bun run dev` or the test suites.

# Which environment the client believes it is in. Drives log labels, telemetry
# and which API base URL is used when PUBLIC_API_BASE_URL is unset.
PUBLIC_MODE=local

# Log level for the browser console and the local NDJSON sink.
PUBLIC_LOG_LEVEL=DEBUG

# Build identifier attached to every log event, so a log can be tied to a
# revision. Overridden in CI with the commit SHA.
PUBLIC_APP_VERSION=dev

# Where the client posts structured log events. Empty disables forwarding —
# which is the default, because forwarding is an explicit deployment decision.
PUBLIC_TELEMETRY_ENDPOINT=

# Absolute API origin. Leave empty to use the page origin (browser) or
# http://127.0.0.1:$PUBLIC_API_PORT (Tauri). Set it when the API is on a
# different host, e.g. a staging Worker.
PUBLIC_API_BASE_URL=

# Port the local Worker listens on. Used only when PUBLIC_API_BASE_URL is unset.
PUBLIC_API_PORT=8787
