{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "starter-web",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  "vars": { "DEPLOYMENT_ENV": "local", "JOBS_PROFILE": "disabled", "CHAT_MODEL_PROFILE": "echo" },
  "env": {
    "staging": { "vars": { "DEPLOYMENT_ENV": "staging", "JOBS_PROFILE": "disabled", "CHAT_MODEL_PROFILE": "echo" } },
    "production": { "vars": { "DEPLOYMENT_ENV": "production", "JOBS_PROFILE": "disabled", "CHAT_MODEL_PROFILE": "echo" } }
  }
}
