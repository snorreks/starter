# Worker environment.
#
# Copy to `.dev.vars` for local development:
#
#   cp .dev.vars.example .dev.vars
#
# `.dev.vars` is gitignored. This file is the only one that carries variable
# names, and every value below is either empty or a local development default.
#
# For a deployed Worker, set these with `wrangler secret put NAME` rather than
# committing anything. `BETTER_AUTH_SECRET` is the only value the application
# cannot do without.

# Which deployment this is. Required, and the only input that decides whether
# development defaults are permitted.
#
# `bun run dev:api` passes this explicitly (--var DEPLOYMENT_ENV:local) and
# wrangler.jsonc sets it for the local top-level environment, so a fresh clone
# works with this file absent. A *deployed* Worker must set it to staging or
# production; the Worker refuses to start if it is missing or unrecognised.
#
# It used to be inferred from BETTER_AUTH_URL — absent, or containing the
# substring "localhost" — which meant a deploy that forgot BETTER_AUTH_URL was
# classified as local and started with the development auth secret. Do not
# reintroduce a hostname heuristic here.
DEPLOYMENT_ENV="local"

# Session signing secret.
# Local: falls back to a development value so `bun run dev:api` works on a fresh
# clone, and so does the literal value `development-only-not-a-secret`.
# Remote: required, must be at least 32 characters, and the development
# placeholder is rejected even when supplied explicitly.
BETTER_AUTH_SECRET=""

# Public base URL of this API, used by Better Auth to build callback URLs.
# Must match where the client will reach it, or sign-in redirects somewhere wrong.
# Required in every environment; must be https outside local.
BETTER_AUTH_URL="http://127.0.0.1:8787"

# Comma-separated origins permitted to send credentialed requests.
#
# An allowlist, not a wildcard: a prefix or suffix match would accept
# `evil-example.com` for `example.com`. Add yours here, one per entry, no spaces.
#
# The Tauri webview origins (`tauri://localhost`, `http://tauri.localhost`) are
# already permitted and do not need to be listed.
TRUSTED_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# Sign-in attempts allowed per period. Defaults to 10, which is production-sane.
# Raise it for a test run that creates many accounts; do not disable it — a
# rate-limit bypass is not normal in a test environment either.
AUTH_RATE_LIMIT_MAX=""

# Build identifier, injected at deploy time so a log line can be traced to the
# artifact that produced it. Unset locally; the log registry reports "dev".
RELEASE=""

# Set by the test harnesses (the integration suite and the Playwright preflight)
# to prove a Worker on a shared port is *this* run's Worker. Leave empty.
TEST_RUN_ID=""