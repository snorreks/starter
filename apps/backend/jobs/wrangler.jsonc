{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "starter-jobs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/index.js",
  "observability": { "enabled": true },
  "vars": { "DEPLOYMENT_ENV": "local", "JOBS_PROFILE": "disabled" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "starter-media" }],
  "workflows": [
    { "binding": "ENCODE_WORKFLOW", "class_name": "EncodeWorkflow", "name": "starter-encode", "limits": { "steps": 32 } },
    { "binding": "MAINTENANCE_WORKFLOW", "class_name": "MaintenanceWorkflow", "name": "starter-maintenance", "limits": { "steps": 16 }, "concurrency": { "limit": 1 } }
  ]
}
