# Development environment activation.
#
# Small on purpose. Everything with a decision in it lives in one of two places:
#
#   flake.nix          what is installed, per profile
#   scripts/src/setup  what a checkout needs prepared, and what doctor checks
#
# This file only activates the environment and calls setup. It does not decrypt
# anything, trust other projects, deploy, migrate a remote database, or edit
# your shell dotfiles — a directory entry should not be able to do any of those.
#
# Profiles: `minimal` for web work, `default` adds a Chromium linked against this
# Nix store, `native` adds the Tauri toolchain. Select one with
# `direnv layout python`… which is to say:
#
#   nix develop            # the default profile
#   nix develop .#native   # Tauri
#   nix develop .#minimal  # no browser, no Rust
#
# Without direnv, the same setup is available as:
#
#   nix develop            # then, in that shell:
#   bun run setup
#   bun run setup:doctor

# `use_flake` is nix-direnv's entrypoint: it evaluates the flake once, caches the
# result, and re-evaluates only when a watched file changes. `inputsFrom` inside
# the flake watches config/toolchain.json, so a version bump invalidates the
# cache.
#
# The fallback chain is for the two ways nix-direnv gets installed, and for the
# case where it is not installed at all — in which case activation says so once
# and continues, rather than failing the whole directory.
if ! type use_flake &>/dev/null 2>&1; then
  if [ -n "${NIX_DIRENV:-}" ] && [ -f "$NIX_DIRENV/share/nix-direnv/direnvrc" ]; then
    # shellcheck disable=SC1091
    . "$NIX_DIRENV/share/nix-direnv/direnvrc"
  elif [ -f "$HOME/.nix-profile/share/nix-direnv/direnvrc" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.nix-profile/share/nix-direnv/direnvrc"
  elif [ -f "$HOME/.config/nix-profile/share/nix-direnv/direnvrc" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.config/nix-profile/share/nix-direnv/direnvrc"
  fi
fi

if type use_flake &>/dev/null 2>&1; then
  # Watched so editing any of them re-activates without `direnv reload`. Only
  # files that change what the shell *is* belong here; a source edit does not.
  watch_file flake.nix flake.lock config/toolchain.json

  # `.envrc` is 20 lines, so this is the whole body of it. Anything longer
  # belongs in `bun run setup`, which is reachable without direnv at all.
  use flake
elif [ -n "${STARTER_ENVRC_WARNED:-}" ]; then
  :
else
  export STARTER_ENVRC_WARNED=1
  echo "nix-direnv is not available, so the flake was not activated."
  echo "  Without it the flake is re-evaluated on every shell entry, and the"
  echo "  pinned tools (sops, age, gh, node) are whatever is on your PATH."
  echo "  One-time fix:"
  echo "    nix profile install nixpkgs#nix-direnv"
  echo "    direnv allow"
  echo "  Or skip direnv entirely and use:  nix develop"
fi

# Idempotent and cached. On a warm checkout this is a hash comparison and a few
# stat calls; on a cold one it runs `bun install` and installs the browsers that
# match the locked Playwright version.
#
# It is invoked here because "the shell activated but the browser is missing" is
# the failure this repository cares most about avoiding. It is *not* invoked with
# any credential: nothing below reads a token, and no remote call is made.
if [ -n "${STARTER_SKIP_SETUP:-}" ]; then
  echo "setup skipped (STARTER_SKIP_SETUP is set)."
elif command -v bun >/dev/null 2>&1; then
  bun run setup >/dev/null 2>&1 || bun run setup
else
  echo "bun is not on PATH yet; skipping project setup. Run \`bun run setup\` once bun exists."
fi