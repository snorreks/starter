{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/.svelte-kit",
      "!**/test-results",
      "!**/playwright-report",
      "!**/.evidence",
      "!**/*.min.js"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "quoteProperties": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": true
      },
      "complexity": {
        "recommended": true,
        "noForEach": "error",
        "noUselessTernary": "error",
        "useArrowFunction": "error",
        "useLiteralKeys": "error",
        "noAdjacentSpacesInRegex": "error"
      },
      "correctness": {
        "recommended": true,
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "nursery": {
        "recommended": true
      },
      "performance": {
        "recommended": true,
        "noDelete": "error"
      },
      "security": {
        "recommended": true
      },
      "style": {
        "recommended": true,
        "noNonNullAssertion": "error",
        "noNestedTernary": "error",
        "useBlockStatements": "error",
        "useConsistentTypeDefinitions": {
          "level": "error"
        },
        "useConsistentObjectDefinitions": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useFilenamingConvention": "off",
        "useNamingConvention": "off"
      },
      "suspicious": {
        "recommended": true,
        "noConsole": {
          "level": "error",
          "options": {
            "allow": []
          }
        },
        "noExplicitAny": "error",
        "noThenProperty": "error",
        "noShadowRestrictedNames": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "error",
            "noParameterAssign": "error"
          },
          "suspicious": {
            "noExplicitAny": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/frontend/client/src/lib/server/**/*.ts",
        "apps/frontend/client/src/hooks.server.ts",
        "apps/frontend/client/src/routes/**/+server.ts",
        "apps/frontend/client/src/routes/**/+page.server.ts",
        "apps/frontend/client/src/routes/**/+layout.server.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Server code has no DOM. Put browser work behind a UI component in packages/frontend.",
                  "document": "Server code has no DOM. Put browser work behind a UI component in packages/frontend.",
                  "localStorage": "Sessions live on the server; the client holds no credential.",
                  "sessionStorage": "Sessions live on the server; the client holds no credential.",
                  "navigator": "Use the shared environment helper in @starter/utils instead."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "svelte/internal",
                      "svelte/reactivity",
                      "svelte/store",
                      "svelte/animate",
                      "svelte/transition",
                      "svelte/easing",
                      "svelte/motion",
                      "svelte/events",
                      "@sveltejs/vite-plugin-svelte",
                      "svelte/"
                    ],
                    "message": "The server plane must not depend on Svelte's client runtime. It runs in workerd with no DOM. Shared view logic belongs in packages/frontend, which this plane may not import."
                  },
                  {
                    "group": ["@starter/ui", "@starter/ui/*"],
                    "message": "The server plane must not import frontend packages. Move shared pure logic into packages/shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/backend/**/*.ts", "scripts/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Server code has no DOM. Put browser work behind a UI component in packages/frontend.",
                  "document": "Server code has no DOM. Put browser work behind a UI component in packages/frontend.",
                  "localStorage": "Sessions live on the server; the client holds no credential.",
                  "sessionStorage": "Sessions live on the server; the client holds no credential.",
                  "navigator": "Use the shared environment helper in @starter/utils instead."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "svelte",
                      "@sveltejs/kit",
                      "@sveltejs/vite-plugin-svelte",
                      "svelte/"
                    ],
                    "message": "The server plane must not depend on Svelte. Shared view logic belongs in packages/frontend, which this plane may not import."
                  },
                  {
                    "group": ["@starter/ui", "@starter/ui/*"],
                    "message": "The server plane must not import frontend packages. Move shared pure logic into packages/shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/frontend/**/*.ts",
        "apps/frontend/**/*.ts",
        "!apps/frontend/**/vite.config.ts",
        "!apps/frontend/**/vitest.config.ts",
        "!apps/frontend/**/svelte.config.js",
        "!apps/frontend/**/scripts/**",
        "!apps/frontend/client/src/lib/server/**",
        "!apps/frontend/client/src/hooks.server.ts",
        "!apps/frontend/client/src/routes/**/+server.ts",
        "!apps/frontend/client/src/routes/**/+page.server.ts",
        "!apps/frontend/client/src/routes/**/+layout.server.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "Frontend code runs in a browser, where Bun is not defined. Put platform-specific work behind an adapter in packages/frontend."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*", "bun:*"],
                    "message": "Frontend code runs in a browser. Put platform-specific work behind a platform adapter in packages/frontend."
                  },
                  {
                    "group": ["@starter/database", "@starter/auth"],
                    "message": "The frontend must not import backend implementation. Share the contract through @starter/schemas instead."
                  },
                  {
                    "group": ["drizzle-orm", "better-auth"],
                    "message": "Database and auth implementation belongs to the server plane. The frontend speaks HTTP."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/tests/**",
        "**/__tests__/**",
        "**/fixtures/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "useNamingConvention": "off",
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off",
            "noRestrictedGlobals": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**/*.ts", ".pi/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/shared/logger/src/lib/console_logger.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      "includes": ["scripts/src/lib/guards/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useBlockStatements": "off",
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/frontend/native/src/lib/test_setup.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" },
          "style": { "noRestrictedImports": "off" }
        }
      }
    },
    {
      "includes": ["apps/frontend/client/src/lib/test_setup.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" },
          "style": { "noRestrictedImports": "off" }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "style": { "useConsistentTypeDefinitions": "off" }
        }
      }
    },
    {
      "includes": ["apps/frontend/client/src/lib/server/container.ts"],
      "linter": {
        "rules": {
          "style": { "useConsistentTypeDefinitions": "off" }
        }
      }
    },
    {
      "includes": [
        "apps/frontend/client/src/routes/+layout.svelte",
        "packages/frontend/ui/src/screen_container.svelte"
      ],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      "includes": [
        "apps/frontend/**/*.ts",
        "apps/frontend/**/*.svelte",
        "!apps/frontend/native/src/lib/platform/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tauri-apps", "@tauri-apps/**"],
                    "message": "Only apps/frontend/native/src/lib/platform/** may name the Tauri API: it is injected by the native shell and does not exist in a browser. Everything else takes an ApiTransport, a SessionStore or an ExternalBrowser by constructor argument."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
