{
  "name": "@starter/scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "lint": "biome lint src tests",
    "format": "biome format src tests",
    "fix": "biome check --write src tests --error-on-warnings",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "guard": "bun run src/cli.ts guard",
    "guard:whole-repo": "bun run src/cli.ts guard --whole-repo"
  },
  "dependencies": {
    "@starter/logger": "workspace:*",
    "@starter/schemas": "workspace:*",
    "@starter/utils": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "4.142.0"
  }
}