{
  "name": "@starter/features",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./notes": {
      "svelte": "./src/notes/index.ts",
      "default": "./src/notes/index.ts"
    },
    "./auth": {
      "svelte": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    "./jobs": {
      "svelte": "./src/jobs/index.ts",
      "default": "./src/jobs/index.ts"
    },
    "./chat": {
      "svelte": "./src/chat/index.ts",
      "default": "./src/chat/index.ts"
    }
  },
  "scripts": {
    "lint": "biome lint src",
    "format": "biome format src",
    "fix": "biome check --write src --error-on-warnings",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "bun test --preload ./src/test_setup.ts"
  },
  "dependencies": {
    "typebox": "1.3.36",
    "@starter/platform": "workspace:*",
    "@starter/schemas": "workspace:*",
    "@starter/ui": "workspace:*",
    "@starter/utils": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "svelte-check": "4.7.6"
  }
}
