{
  "name": "@starter/frontend-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./base": "./src/base/index.ts",
    "./platform": "./src/platform/index.ts"
  },
  "scripts": {
    "lint": "biome lint src",
    "format": "biome format src",
    "fix": "biome check --write src --error-on-warnings",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@starter/logger": "workspace:*",
    "@starter/schemas": "workspace:*",
    "@starter/utils": "workspace:*",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "svelte-check": "4.7.6"
  }
}
