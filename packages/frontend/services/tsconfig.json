{
  "extends": "../../../config/tsconfig/tsconfig.frontend.json",
  "compilerOptions": {
    "types": ["bun"],
    "paths": {
      "@starter/logger": ["../../shared/logger/src/index.ts"],
      "@starter/logger/*": ["../../shared/logger/src/*"],
      "@starter/schemas": ["../../shared/schemas/src/index.ts"],
      "@starter/schemas/*": ["../../shared/schemas/src/*"],
      "@starter/utils": ["../../shared/utils/src/index.ts"],
      "@starter/utils/*": ["../../shared/utils/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
