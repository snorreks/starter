{
  "name": "@starter/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "svelte": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./base": "./src/base/index.ts",
    "./feedback": "./src/feedback/index.ts",
    "./notes": "./src/notes/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "lint": "biome lint src",
    "format": "biome format src",
    "fix": "biome check --write src --error-on-warnings",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@starter/frontend-services": "workspace:*",
    "@starter/schemas": "workspace:*",
    "@starter/utils": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
