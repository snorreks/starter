{
  "name": "@starter/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./screen": {
      "svelte": "./src/screen.ts",
      "default": "./src/screen.ts"
    },
    "./feedback": {
      "svelte": "./src/feedback/index.ts",
      "default": "./src/feedback/index.ts"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "lint": "biome lint src",
    "format": "biome format src",
    "fix": "biome check --write src --error-on-warnings",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@starter/schemas": "workspace:*",
    "@starter/utils": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte-check": "4.7.6"
  }
}
