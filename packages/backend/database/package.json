{
  "name": "@starter/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./supabase": "./src/supabase/index.ts"
  },
  "scripts": {
    "supabase": "supabase",
    "db:local:migrate": "bun run tools/local_migrate.ts",
    "db:types": "bun run tools/types_generate.ts",
    "db:types:check": "bun run tools/types_check.ts",
    "test:integration": "bun test tests/supabase.integration.test.ts",
    "lint": "biome lint src tools tests",
    "format": "biome format src tools tests",
    "fix": "biome check --write src tools tests --error-on-warnings",
    "typecheck": "tsgo --noemit",
    "test": "bun test src"
  },
  "dependencies": {
    "@starter/schemas": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "supabase": "2.120.0"
  }
}
