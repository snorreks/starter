{
  "name": "@starter/monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/shared/*",
    "packages/backend/*",
    "packages/frontend/*",
    "apps/frontend/*",
    "apps/e2e",
    "scripts",
    ".pi"
  ],
  "scripts": {
    "moon": "bunx moon",
    "dev": "bun run scripts/src/cli.ts dev app",
    "dev:worker": "bun run scripts/src/cli.ts dev built",
    "build": "bun run scripts/src/cli.ts cached -- client:build",
    "check:bundle": "bun run scripts/src/cli.ts cached -- client:check-bundle",
    "test": "bun run scripts/src/cli.ts cached -- :test",
    "test:watch": "bun run scripts/src/cli.ts cached -- :test -- --watch",
    "lint": "bun run scripts/src/cli.ts cached -- :lint",
    "format": "bun run scripts/src/cli.ts cached -- :format",
    "fix": "bun run scripts/src/cli.ts cached -- :fix",
    "typecheck": "bun run scripts/src/cli.ts cached -- :typecheck",
    "validate": "bun run scripts/src/cli.ts cached -- :validate",
    "guard": "bun run scripts/src/cli.ts guard",
    "guard:whole-repo": "bun run scripts/src/cli.ts guard --whole-repo",
    "ci": "bun run scripts/src/cli.ts ci",
    "clean": "rm -rf node_modules",
    "clean:all": "rm -rf node_modules .svelte-kit build dist .moon/cache .wrangler state",
    "setup": "bun run scripts/src/cli.ts setup",
    "setup:doctor": "bun run scripts/src/cli.ts doctor",
    "setup:secrets": "bun run scripts/src/cli.ts secrets doctor",
    "logs": "bun run scripts/src/cli.ts logs",
    "logs:local": "bun run scripts/src/cli.ts logs web --mode local --follow",
    "db:generate": "moon run database:db-generate",
    "db:migrate": "bun run scripts/src/cli.ts db migrate --local",
    "db:migrate:remote": "bun run scripts/src/cli.ts db migrate --remote",
    "db:status": "bun run scripts/src/cli.ts db status",
    "db:seed": "bun run scripts/src/cli.ts db seed",
    "contract": "bun run scripts/src/cli.ts contract",
    "contract:status": "bun run scripts/src/cli.ts contract status",
    "deploy:configure": "bun run scripts/src/cli.ts configure",
    "deploy:check": "bun run scripts/src/cli.ts deploy --dry-run",
    "deploy": "bun run scripts/src/cli.ts deploy",
    "e2e": "bun run scripts/src/cli.ts cached -- e2e:e2e",
    "e2e:visual": "moon run e2e:capture-evidence",
    "workflows": "bun run scripts/src/cli.ts workflows",
    "smoke": "bun run scripts/src/cli.ts smoke",
    "secrets:init": "bun run scripts/src/cli.ts secrets init",
    "secrets:encrypt": "bun run scripts/src/cli.ts secrets encrypt",
    "secrets:decrypt": "bun run scripts/src/cli.ts secrets decrypt",
    "secrets:exec": "bun run scripts/src/cli.ts secrets exec",
    "secrets:update-recipients": "bun run scripts/src/cli.ts secrets update-recipients",
    "test:worker": "bun run scripts/src/cli.ts cached -- client:test-worker",
    "test:browser": "bun run scripts/src/cli.ts cached -- client:test-browser",
    "test:browser-launch": "bun run scripts/src/cli.ts cached -- scripts:test-browser-launch",
    "test:e2e": "bun run scripts/src/cli.ts cached -- e2e:e2e",
    "test:all": "bun run test && bun run test:browser && bun run test:worker && bun run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@moonrepo/cli": "2.5.5",
    "@types/bun": "1.4.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
