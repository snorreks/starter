{
  "name": "@starter/monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/shared/*",
    "packages/backend/*",
    "packages/frontend/*",
    "apps/frontend/*",
    "apps/backend/*",
    "apps/e2e",
    "scripts",
    ".pi"
  ],
  "scripts": {
    "moon": "bunx moon",
    "dev": "moon run client:dev",
    "dev:api": "bun run scripts/src/cli.ts dev api",
    "build": "moon run client:build",
    "check:bundle": "moon run client:check-bundle",
    "test": "moon run :test",
    "test:watch": "moon run :test -- --watch",
    "lint": "moon run :lint",
    "format": "moon run :format",
    "fix": "moon run :fix",
    "typecheck": "moon run :typecheck",
    "validate": "moon run :validate",
    "guard": "moon run scripts:guard",
    "guard:whole-repo": "moon run scripts:guard-whole-repo",
    "ci": "bun run scripts/src/cli.ts ci",
    "clean": "rm -rf node_modules",
    "clean:all": "rm -rf node_modules .svelte-kit build dist .moon/cache .wrangler state",
    "setup": "bun run scripts/src/cli.ts setup",
    "setup:doctor": "bun run scripts/src/cli.ts doctor",
    "setup:secrets": "bun run scripts/src/cli.ts secrets doctor",
    "logs": "bun run scripts/src/cli.ts logs",
    "logs:local": "bun run scripts/src/cli.ts logs all --mode local --follow",
    "db:generate": "moon run database:db-generate",
    "db:migrate": "bun run scripts/src/cli.ts db migrate --local",
    "db:migrate:remote": "bun run scripts/src/cli.ts db migrate --remote",
    "db:status": "bun run scripts/src/cli.ts db status",
    "db:seed": "bun run scripts/src/cli.ts db seed",
    "contract": "bun run scripts/src/cli.ts contract",
    "contract:status": "bun run scripts/src/cli.ts contract status",
    "deploy:configure": "bun run scripts/src/cli.ts configure",
    "deploy:check": "bun run scripts/src/cli.ts deploy --dry-run",
    "deploy": "bun run scripts/src/cli.ts deploy",
    "e2e": "moon run e2e:e2e",
    "e2e:visual": "moon run e2e:capture-evidence",
    "secrets:init": "bun run scripts/src/cli.ts secrets init",
    "secrets:encrypt": "bun run scripts/src/cli.ts secrets encrypt",
    "secrets:decrypt": "bun run scripts/src/cli.ts secrets decrypt",
    "secrets:exec": "bun run scripts/src/cli.ts secrets exec",
    "secrets:update-recipients": "bun run scripts/src/cli.ts secrets update-recipients",
    "test:integration": "moon run api:test-integration",
    "test:browser": "moon run client:test-browser",
    "test:e2e": "moon run e2e:e2e",
    "test:all": "bun run test && bun run test:browser && bun run test:integration && bun run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@moonrepo/cli": "2.5.5",
    "@types/bun": "1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
